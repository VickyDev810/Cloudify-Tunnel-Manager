#!/usr/bin/env python3
"""Fake cloudflared for tests: emulates the subcommands Cloudify uses.

"Cloudflare" state (accounts, tunnels, DNS, connectors) lives in $FAKE_CF_DB,
default $HOME/.cloudflared/.fakecf.json. Several Cloudify "machines" (HOMEs)
can share one FAKE_CF_DB, like several servers using one Cloudflare account.

Login certificates use the real format (an ARGO TUNNEL TOKEN block holding
base64 JSON with zoneID/accountID/apiToken). The zone a login authorizes comes
from $CLOUDIFY_LOGIN_DOMAIN (set by Cloudify) and the account from
$FAKE_CF_ACCOUNTS ("example.com=acct-a,other.org=acct-b"; default acct-a).
"""
import base64, contextlib, fcntl, json, os, signal, sys, time, uuid

H = os.path.expanduser("~")
CF = os.path.join(H, ".cloudflared")
DB = os.environ.get("FAKE_CF_DB") or os.path.join(CF, ".fakecf.json")
args = sys.argv[1:]
os.makedirs(os.path.dirname(DB) or ".", exist_ok=True)
with open(os.path.join(os.path.dirname(DB) or ".", ".fakecf.calls"), "a") as log:
    log.write(" ".join(args) + "\n")


def load():
    try:
        with open(DB) as f:
            db = json.load(f)
    except (OSError, ValueError):
        db = {}
    for key in ("tunnels", "dns", "connectors", "zones"):
        db.setdefault(key, {} if key in ("dns", "zones") else [])
    return db


@contextlib.contextmanager
def locked():
    """Serialize read-modify-write of the shared "Cloudflare" state across processes."""
    os.makedirs(os.path.dirname(DB) or ".", exist_ok=True)
    with open(DB + ".lock", "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def save(db):
    os.makedirs(os.path.dirname(DB) or ".", exist_ok=True)
    tmp = f"{DB}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(db, f)
    os.replace(tmp, DB)


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


if args and args[0] in ("--version", "version"):
    print("cloudflared version 2025.1.0 (built 2025-01-01)")
    sys.exit(0)
if args == ["update"]:
    fail("cloudflared was installed by a package manager. Please update using the same method.")
if args[:1] != ["tunnel"]:
    sys.exit(2)
args = args[1:]

config = cert_path = metrics = url = None
while args and args[0].startswith("--"):
    flag = args.pop(0)
    if flag in ("--config", "--origincert", "--metrics", "--url"):
        value = args.pop(0)
        if flag == "--config":
            config = value
        elif flag == "--origincert":
            cert_path = value
        elif flag == "--url":
            url = value
        else:
            metrics = value
cert_path = cert_path or os.path.join(CF, "cert.pem")
cmd = args[0] if args else ""

if url and not cmd:  # quick tunnel: print a URL like the real one does, run until stopped
    print(f"INF |  https://fake-{uuid.uuid4().hex[:12]}.trycloudflare.com  |", file=sys.stderr, flush=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    while True:
        time.sleep(1)


def read_cert():
    try:
        text = open(cert_path).read()
        body = text.split("-----BEGIN ARGO TUNNEL TOKEN-----")[1].split("-----END")[0]
        return json.loads(base64.b64decode("".join(body.split())))
    except (OSError, IndexError, ValueError):
        fail(f"Cannot determine default origin certificate path. No file cert.pem in {cert_path}")


def alive(pid):
    try:
        os.kill(pid, 0)
        with open(f"/proc/{pid}/stat") as f:
            return f.read().split()[2] != "Z"
    except OSError:
        return False


if cmd == "login":
    target = os.path.join(CF, "cert.pem")
    if os.path.exists(target):
        print(f"You have an existing certificate at {target} which login would overwrite.", file=sys.stderr)
        sys.exit(0)  # the real cloudflared exits 0 here too
    domain = os.environ.get("CLOUDIFY_LOGIN_DOMAIN") or "example.com"
    accounts = dict(p.split("=") for p in os.environ.get("FAKE_CF_ACCOUNTS", "").split(",") if "=" in p)
    token = {"zoneID": "zone-" + domain.replace(".", "-"), "accountID": accounts.get(domain, "acct-a"),
             "apiToken": "fake-token", "fakeZone": domain}
    print("Please open the following URL and log in with your Cloudflare account:\n\n"
          "https://dash.cloudflare.com/argotunnel?aud=&callback=https%3A%2F%2Flogin.cloudflareaccess.org%2Fabc\n\n"
          "Leave cloudflared running to download the cert automatically.", flush=True)
    time.sleep(float(os.environ.get("FAKE_CF_LOGIN_DELAY", "1.5")))
    with locked():
        db = load()
        db["zones"][token["zoneID"]] = domain
        save(db)
    os.makedirs(CF, exist_ok=True)
    with open(target, "w") as f:
        f.write("-----BEGIN ARGO TUNNEL TOKEN-----\n"
                + base64.b64encode(json.dumps(token).encode()).decode() + "\n-----END ARGO TUNNEL TOKEN-----\n")
    print(f"You have successfully logged in.\nIf you wish to copy your credentials to a server, "
          f"they have been saved to:\n{target}")
    sys.exit(0)

if cmd == "run":
    name = args[1]
    if not config or not os.path.exists(config):
        fail("config missing")
    creds = None
    for line in open(config):
        if line.startswith("credentials-file:"):
            creds = line.split(":", 1)[1].strip().strip("'\"")
    if not creds or not os.path.exists(creds):
        fail("tunnel credentials file not found")
    tunnel_id = json.load(open(creds))["TunnelID"]
    with locked():
        db = load()
        db["connectors"] = [c for c in db["connectors"] if alive(c["pid"])]
        db["connectors"].append({"tunnel_id": tunnel_id, "pid": os.getpid(),
                                 "origin_ip": f"10.0.0.{os.getpid() % 250}", "home": H,
                                 "run_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})
        save(db)
    print(f"INF Starting tunnel tunnelID={tunnel_id}", flush=True)
    if metrics:  # like cloudflared's metrics server: GET /ready
        import threading
        from http.server import BaseHTTPRequestHandler, HTTPServer

        class Ready(BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def do_GET(self):
                body = json.dumps({"status": 200, "readyConnections": 4,
                                   "connectorId": f"connector-{os.getpid()}"}).encode()
                self.send_response(200 if self.path == "/ready" else 404)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(body)

        host, port = metrics.rsplit(":", 1)
        threading.Thread(target=HTTPServer((host, int(port)), Ready).serve_forever, daemon=True).start()

    def stop(*_):
        with locked():
            d = load()
            d["connectors"] = [c for c in d["connectors"] if c["pid"] != os.getpid()]
            save(d)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while True:
        time.sleep(1)

cert = read_cert()
account = cert["accountID"]
_lock = locked()
_lock.__enter__()  # held until this command exits
db = load()
mine = [t for t in db["tunnels"] if t["account"] == account]


def find(ref):
    return next((t for t in mine if ref in (t["name"], t["id"])), None)


if cmd == "list":
    listing = [{"id": t["id"], "name": t["name"]} for t in mine]
    print(json.dumps(listing) if "--output" in args and listing else ("null" if "--output" in args else
          "\n".join(["ID NAME"] + [f"{t['id']} {t['name']}" for t in listing])))
elif cmd == "create":
    name = args[1]
    if find(name):
        fail(f"tunnel with name {name} already exists")
    tunnel = {"id": str(uuid.uuid4()), "name": name, "account": account}
    db["tunnels"].append(tunnel)
    save(db)
    with open(os.path.join(CF, f"{tunnel['id']}.json"), "w") as f:
        json.dump({"AccountTag": account, "TunnelSecret": base64.b64encode(os.urandom(32)).decode(),
                   "TunnelID": tunnel["id"]}, f)
    print(f"Tunnel credentials written to {CF}/{tunnel['id']}.json\nCreated tunnel {name} with id {tunnel['id']}")
elif cmd == "route" and args[1] == "dns":
    rest = [a for a in args[2:] if not a.startswith("-")]
    overwrite = "--overwrite-dns" in args or "-f" in args
    tunnel, hostname = find(rest[0]), rest[1]
    if not tunnel:
        fail("tunnel not found")
    zone = cert["fakeZone"]
    record = hostname if hostname == zone or hostname.endswith("." + zone) else f"{hostname}.{zone}"
    existing = db["dns"].get(record)
    if existing and existing != tunnel["id"] and not overwrite:
        fail(f"Failed to add route: code: 1003, reason: An A, AAAA, or CNAME record with that host already exists.")
    db["dns"][record] = tunnel["id"]
    save(db)
    print(f"Added CNAME {record} which will route to this tunnel tunnelID={tunnel['id']}")
elif cmd == "info":
    tunnel = find([a for a in args[1:] if not a.startswith("-")][-1])
    if not tunnel:
        fail("tunnel not found")
    conns = [c for c in db["connectors"] if c["tunnel_id"] == tunnel["id"] and alive(c["pid"])]
    colos = ["fra01", "fra08", "ams01", "ams04"]
    print(json.dumps({"id": tunnel["id"], "name": tunnel["name"], "conns": [
        {"id": f"connector-{c['pid']}", "version": "2025.1.0", "arch": "linux_amd64", "run_at": c.get("run_at"),
         "conns": [{"colo_name": colo, "origin_ip": c["origin_ip"], "is_pending_reconnect": False,
                    "opened_at": c.get("run_at")} for colo in colos]}
        for c in conns]}))
elif cmd == "cleanup":
    pass
elif cmd == "delete":
    ref = [a for a in args[1:] if not a.startswith("-")][0]
    tunnel = find(ref)
    if not tunnel:
        fail(f'"{ref}" is neither the ID nor the name of any of your tunnels')
    if any(c["tunnel_id"] == tunnel["id"] and alive(c["pid"]) for c in db["connectors"]) and "-f" not in args:
        fail("Cannot delete tunnel because it has active connections.")
    db["tunnels"] = [t for t in db["tunnels"] if t is not tunnel]
    save(db)
    print("Deleted")
else:
    fail(f"unknown {args}")
