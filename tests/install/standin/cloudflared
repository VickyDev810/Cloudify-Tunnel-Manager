#!/usr/bin/env python3
# Used by tests/install/safety.sh and tests/test_safety_check.py (never by Cloudify itself).
# Stand-in for cloudflared: quick tunnels answer /quicktunnel, named tunnels /ready, on their --metrics port
import http.server, json, signal, sys, threading, time
args = sys.argv[1:]
quick = "--url" in args and "run" not in args
if "--metrics" in args:
    host, port = args[args.index("--metrics") + 1].rsplit(":", 1)
    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == "/quicktunnel" and quick:
                body = {"hostname": "stand-in-%s.trycloudflare.com" % port}
            elif self.path == "/ready":
                body = {"status": 200, "readyConnections": 4}
            else:
                self.send_response(404); self.end_headers(); return
            self.send_response(200); self.end_headers(); self.wfile.write(json.dumps(body).encode())
        def log_message(self, *a): pass
    srv = http.server.HTTPServer((host, int(port)), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
while True:
    time.sleep(3600)
